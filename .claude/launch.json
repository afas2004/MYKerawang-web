{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--release",
        "--web-port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "web-debug",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port", "8081"],
      "port": 8081
    }
  ]
}
